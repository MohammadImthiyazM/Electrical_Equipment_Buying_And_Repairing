  "description": "An Angular app with login/signup functionality using MongoDB Compass",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:backend": "node src/server.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
